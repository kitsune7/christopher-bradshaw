{
  "name": "christopher-bradshaw",
  "description": "My personal website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:integration && npm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run"
  },
  "author": "Christopher Bradshaw",
  "license": "MIT",
  "homepage": "https://github.com/kitsune7/christopher-bradshaw#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kitsune7/christopher-bradshaw"
  },
  "bugs": {
    "url": "https://github.com/kitsune7/christopher-bradshaw/issues"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.1",
    "@typescript-eslint/parser": "~8.72.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "~8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24.18",
    "pnpm": ">=11"
  }
}
